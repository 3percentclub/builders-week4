# Midnight Rental settings. ALL OPTIONAL: with nothing set, the lab, Part 2 search/evals,
# and homework Levels 1-2 run with no key.
#
# To use a chat model: copy this file to `.env` (same folder) and fill in LLM_API_KEY.
#   macOS/Linux: cp .env.example .env      Windows: copy .env.example .env
# `.env` is gitignored, so your key never gets committed.
# In Colab, add the same names as Secrets instead (key icon in the left sidebar).

# Any provider's key. The provider is detected from how the key starts:
#   sk-or-  OpenRouter      gsk_  Groq        AIza  Google Gemini
#   sk-ant- Anthropic       vck_  Vercel AI Gateway      sk-  OpenAI or DeepSeek
# (A Claude Pro/Max login from Claude Code is not an API key. See the README's Claude Code section.)
LLM_API_KEY=

# Optional. Blank = we ask your provider and pick a small chat model.
LLM_MODEL=

# Only for local or custom servers (Ollama, LM Studio, vLLM, a company proxy), or a key
# whose provider isn't detected. Must be OpenAI-compatible. Examples:
#   http://localhost:11434/v1   (Ollama, with LLM_MODEL=llama3.1)
LLM_BASE_URL=
